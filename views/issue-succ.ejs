<!DOCTYPE html>
<html>
  <head>
    <title>Issue Submitted - CricPulse</title>

    <link
      rel="icon"
      href="https://thumbs.dreamstime.com/b/cricket-sport-comet-fire-tail-flying-throw-logo-isolated-symbol-icon-badge-89929962.jpg"
    />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body
    class="bg-gradient-to-r from-blue-900 via-black to-red-900 min-h-screen flex flex-col"
  >
    <!-- Navbar -->

    <nav class="bg-black/40 backdrop-blur-md border-b border-white/10">
      <div
        class="max-w-7xl mx-auto px-4 md:px-6 py-4 flex justify-between items-center text-white"
      >
        <h1 class="text-2xl font-bold text-red-500">
          Cric<span class="text-white">Pulse</span>
        </h1>

        <div class="space-x-4 font-bold text-sm md:text-base">
          <a href="/" class="hover:text-red-400">Home</a>
          <a href="/watch-live" class="hover:text-red-400">Watch</a>
        </div>
      </div>
    </nav>

    <!-- Success Message -->

    <div class="flex-grow flex items-center justify-center px-6 py-12">
      <div
        class="bg-white/10 backdrop-blur-lg p-10 rounded-2xl shadow-xl border border-white/20 text-center max-w-xl text-white"
      >
        <div class="text-6xl mb-4">✅</div>

        <h2 class="text-3xl font-bold text-green-400 mb-4">
          Issue Submitted Successfully
        </h2>

        <p class="text-gray-300 text-lg leading-relaxed">
          Your streaming issue has been successfully submitted to the
          <span class="text-yellow-400 font-semibold"
            >CricPulse Support Team</span
          >.
        </p>

        <p class="text-gray-300 mt-4">
          Our team will review your problem and send a solution to your
          <span class="text-blue-400 font-semibold">email address</span>
          shortly.
        </p>

        <p class="text-gray-400 mt-4 text-sm">
          Thank you for helping us improve your streaming experience.
        </p>
      </div>
    </div>

    <footer
      class="bg-black/50 border-t border-white/20 text-center py-5 text-white"
    >
      © 2026 CricPulse • Developed by Naveen Rathore
    </footer>
  </body>
</html>
