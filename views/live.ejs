<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CricPulse Live 🔴</title>

<link rel="icon"
href="https://thumbs.dreamstime.com/b/cricket-sport-comet-fire-tail-flying-throw-logo-isolated-symbol-icon-badge-89929962.jpg"
type="image/x-icon"/>

<script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-gradient-to-r from-black via-blue-950 to-black min-h-screen text-white flex flex-col">

<!-- Navbar -->
<nav class="flex justify-between items-center px-4 py-3 bg-black/60 backdrop-blur-md shadow-lg">

<h1 class="text-xl font-bold text-red-500">
Cric<span class="text-white">Pulse</span>
</h1>

<div class="space-x-4 text-sm">
<a href="/" class="hover:text-red-400">Home</a>
<a href="/help" class="hover:text-red-400">Help</a>
</div>

</nav>


<!-- Main -->
<div class="flex-grow">

<!-- Heading -->
<div class="text-center mt-8 px-3">

<h1 class="text-2xl md:text-5xl font-extrabold">
🏏 Live Cricket Streaming
</h1>

<p class="text-gray-400 mt-2 text-sm">
Watch match live in HD
</p>

</div>


<!-- Video Section -->
<div class="flex justify-center mt-8 px-3">

<div class="bg-black/70 p-3 md:p-6 rounded-2xl shadow-2xl w-full max-w-4xl">


<!-- Top Bar -->
<div class="flex items-center justify-between flex-nowrap mb-4">

<!-- LEFT -->
<div class="flex items-center gap-2">

<span class="bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full animate-pulse">
LIVE
</span>

<span class="text-gray-300 text-xs sm:text-sm">
Streaming Now
</span>

</div>


<!-- RIGHT -->
<div class="flex items-center gap-2">

<!-- Live Users -->
<div class="flex items-center gap-1 bg-red-600 text-white px-2 py-1 rounded-full text-xs font-bold">

<span class="relative flex h-2 w-2">

<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>

<span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>

</span>

<span id="liveUsers">0</span> Live

</div>


<!-- Help Button -->
<button
onclick="openHelp()"
class="bg-blue-600 hover:bg-blue-700 px-2 py-1 rounded-md text-xs font-semibold">
Help
</button>

</div>

</div>


<!-- Video -->
<div id="video-container" class="aspect-video w-full">

<iframe
class="w-full h-full rounded-xl shadow-lg"
src="https://allrounder-live.pages.dev/star/modder-guy"
frameborder="0"
allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
allowfullscreen>
</iframe>

</div>

</div>

</div>

</div>


<!-- Help Modal -->
<div id="helpModal"
class="hidden fixed inset-0 bg-black/80 flex items-center justify-center z-50 px-4">

<div class="bg-gray-900 p-5 rounded-xl max-w-md w-full shadow-2xl">

<h2 class="text-xl font-bold mb-4">
Streaming Help
</h2>

<ul class="space-y-2 text-gray-300 text-sm">

<li>📶 Check your internet connection.</li>
<li>🔄 Refresh page if video not loading.</li>
<li>🎧 Use headphones for better sound.</li>
<li>📱 Rotate phone for full screen.</li>

</ul>

<button
onclick="closeHelp()"
class="mt-6 w-full bg-red-600 hover:bg-red-700 py-2 rounded-lg">

Close

</button>

</div>

</div>


<!-- Footer -->
<footer
class="bg-black/50 border-t border-white/20 text-center py-4 text-xs">

© 2026

<span class="font-bold text-red-500">
Cric<span class="text-white">Pulse</span>
</span>

• Developed by Naveen Rathore

</footer>



<script>

function openHelp(){
document.getElementById("helpModal").classList.remove("hidden")
}

function closeHelp(){
document.getElementById("helpModal").classList.add("hidden")
}

</script>


<script src="/socket.io/socket.io.js"></script>

<script>

const socket = io()

socket.on("updateUsers", function(count){
document.getElementById("liveUsers").innerText = count
})

</script>

</body>
</html>