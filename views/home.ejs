<!DOCTYPE html>
<html>
  <head>
    <title>CricPulse-live</title>

    <!-- <link
      rel="icon"
      href="https://thumbs.dreamstime.com/b/cricket-sport-comet-fire-tail-flying-throw-logo-isolated-symbol-icon-badge-89929962.jpg"
    /> -->
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body
    class="bg-gradient-to-r from-blue-900 via-black to-red-900 min-h-screen flex flex-col text-white"
  >
    <!-- NAVBAR -->

    <nav
      class="bg-black/70 backdrop-blur-md border-b border-white/10 sticky top-0 z-50"
    >
      <div
        class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center"
      >
        <a href="/" class="text-2xl md:text-3xl font-bold text-red-500">
          Cric<span class="text-white">Pulse</span>
        </a>

        <div class="hidden md:flex gap-6 text-sm md:text-base font-semibold">
          <a href="/" class="hover:text-red-400 transition">Home</a>
          <a href="/squads" class="hover:text-red-400 transition">Squads</a>
          <a href="/help" class="hover:text-red-400 transition">Help</a>
          <a href="/contact" class="hover:text-red-400 transition">Contact</a>
          <a href="/legal" class="hover:text-red-400 transition">Disclaimer</a>
        </div>

        <button
          onclick="toggleMenu()"
          class="md:hidden flex items-center justify-center w-10 h-10 rounded-xl bg-white/10 hover:bg-red-500 backdrop-blur-lg shadow-lg transition"
        >
          <span class="text-xl">☰</span>
        </button>
      </div>
    </nav>

    <!-- MOBILE MENU -->

    <div
      id="mobileMenu"
      class="fixed top-0 right-[-270px] w-[260px] bg-black/95 backdrop-blur-xl shadow-2xl rounded-l-3xl transition-all duration-300 z-50"
    >
      <div
        class="p-6 flex flex-col gap-6 text-lg font-semibold items-center text-center"
      >
        <h2 class="text-xl font-bold text-red-500 self-start">
          Cric<span class="text-white">Pulse</span>
        </h2>

        <a href="/watch-live" class="hover:text-red-400">📺 Watch</a>
        <a href="/squads" class="hover:text-red-400">🏏 Squads</a>
        <a href="/help" class="hover:text-red-400">❓ Help</a>
        <a href="/legal" class="hover:text-red-400">⚠️ Disclaimer</a>
        <a href="/contact" class="hover:text-red-400">📩 Contact</a>

        <button
          onclick="toggleMenu()"
          class="mt-4 w-full py-3 rounded-xl bg-red-600 hover:bg-red-700 font-bold shadow-lg"
        >
          Close
        </button>
      </div>
    </div>

    <!-- MAIN -->

    <div class="flex-grow max-w-7xl mx-auto px-4 py-8 space-y-10">
      <!-- SLIDER -->

      <div
        class="relative w-full max-w-6xl mx-auto aspect-video overflow-hidden rounded-3xl shadow-2xl border border-white/20"
      >
        <img
          id="slider"
          class="w-full h-full object-cover transition duration-700"
        />

        <div
          class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"
        ></div>

        <div class="absolute bottom-6 left-6 md:bottom-10 md:left-10 max-w-xl">
          <h2
            id="slideTitle"
            class="text-xl md:text-3xl font-bold text-white"
          ></h2>

          <p id="slideDesc" class="text-sm md:text-lg text-gray-300 mt-2"></p>
        </div>

        <div
          id="dots"
          class="absolute bottom-4 w-full flex justify-center gap-3"
        ></div>
      </div>

      <!-- PAGE HEADING -->

      <div class="text-center space-y-4">
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-wide">
          <span class="text-yellow-400">CRICKET</span>
          <span class="text-white">LIVE</span>
        </h1>

        <h2 class="text-lg md:text-2xl text-gray-300 font-semibold">
          IPL • ICC T20 World Cup • Live Matches
        </h2>
      </div>

      <!-- LIVE USERS -->

      <div class="flex justify-center">
        <div
          class="flex items-center gap-3 bg-black/70 border border-red-500/40 px-6 py-3 rounded-full backdrop-blur-md shadow-lg"
        >
          <span class="relative flex h-3 w-3">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-500 opacity-75"
            ></span>
            <span
              class="relative inline-flex rounded-full h-3 w-3 bg-red-600"
            ></span>
          </span>

          <span class="text-red-400 font-semibold">LIVE WATCHING</span>

          <span
            id="liveUsers"
            class="bg-red-600 px-3 py-1 rounded-full font-bold"
            >0</span
          >
        </div>
      </div>

      <!-- MATCH CARD -->
      <div class="flex justify-center mt-6">
        <div
          class="w-full max-w-md bg-gradient-to-br from-gray-900 via-black to-gray-900 p-[2px] rounded-3xl shadow-2xl"
        >
          <div class="bg-gray-900 rounded-3xl p-6 text-center space-y-6">
            <!-- UPCOMING TEXT -->
            <p class="text-red-400 font-semibold animate-pulse">
              🔴 Upcoming Live Match
            </p>

            <!-- TITLE -->
            <h2
              class="text-xl md:text-2xl font-bold text-yellow-400 tracking-wide"
            >
              IPL 2026 OPENER
            </h2>

            <!-- TEAMS -->
            <div class="flex justify-center items-center gap-8">
              <!-- TEAM 1 -->
              <div class="flex flex-col items-center gap-2">
                <img
                  src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRgW4ecfy4QlpfTyN4DFhnU09IzmqOy87lZnQ&s"
                  class="w-16 h-16 object-contain"
                />
                <span class="text-lg font-bold">RCB</span>
              </div>

              <!-- VS BADGE -->
              <div
                class="px-4 py-2 rounded-full bg-red-600 text-white font-bold shadow-lg"
              >
                VS
              </div>

              <!-- TEAM 2 -->
              <div class="flex flex-col items-center gap-2">
                <img
                  src="https://upload.wikimedia.org/wikipedia/en/thumb/5/51/Sunrisers_Hyderabad_Logo.svg/250px-Sunrisers_Hyderabad_Logo.svg.png"
                  class="w-16 h-16 object-contain"
                />
                <span class="text-lg font-bold">SRH</span>
              </div>
            </div>

            <!-- MATCH DETAILS -->
            <div class="text-gray-300 text-sm leading-relaxed">
              📅 <span class="text-white font-semibold">28 March 2026</span>
              <br />
              🏟
              <span class="text-white font-semibold"
                >M. Chinnaswamy Stadium, Bengaluru</span
              >
            </div>

            <!-- COUNTDOWN -->
            <div
              id="countdown1"
              class="text-3xl font-mono text-yellow-400 bg-black/50 py-3 rounded-lg border border-yellow-400/20"
            ></div>
          </div>
        </div>
      </div>

      <!-- IPL ANNOUNCEMENT -->

      <div class="flex justify-center px-2">
        <div
          class="w-full max-w-2xl bg-gradient-to-r from-purple-900/60 via-black/80 to-red-900/60 border border-white/10 rounded-3xl shadow-2xl overflow-hidden backdrop-blur-lg"
        >
          <!-- IMAGE -->

          <img
            src="https://img10.hotstar.com/image/upload/f_auto,q_90,w_1920/sources/r1/cms/prod/8736/1772978088736-i"
            class="w-full h-40 sm:h-48 md:h-56 object-cover object-top"
          />

          <!-- TEXT -->

          <div class="p-4 sm:p-6 text-center space-y-3 sm:space-y-4">
            <h2
              class="text-xl sm:text-2xl md:text-3xl font-bold text-yellow-400"
            >
              🏏 IPL 2026 Live Matches
            </h2>

            <p class="text-gray-300 text-sm sm:text-base leading-relaxed">
              The biggest T20 cricket league
              <span class="text-white font-semibold"
                >Indian Premier League 2026</span
              >
              will begin from

              <span class="text-red-400 font-bold">28 March 2026</span>.

              <span class="text-white font-semibold">CricPulse</span> will
              provide
              <span class="text-yellow-400 font-semibold"
                >Live Match Streaming and Official Team Squads</span
              >
              for upcoming matches. Stay tuned as the live match section will be
              activated very soon.
            </p>

            <p
              class="text-red-400 font-semibold animate-pulse text-sm sm:text-base"
            >
              🔴 Live Matches Coverage Coming Soon
            </p>
          </div>
        </div>
      </div>

      <!-- BUTTONS -->

      <div class="flex flex-col items-center gap-6">
        <a href="/squads">
          <button
            class="px-6 py-2 text-lg rounded-full font-bold bg-gradient-to-r from-red-500 via-orange-500 to-yellow-400 hover:scale-110 transition hover:scale-110 transition duration-300 shadow-xl"
            style="text-shadow: 1px 1px 6px rgba(0, 0, 0, 0.8)"
          >
            👥 View Squad
          </button>
        </a>

        <a href="/live-info">
          <button
            class="w-[295px] py-3 text-lg rounded-full font-bold text-white bg-gradient-to-r from-[#0047AB] via-[#1E90FF] to-[#00BFFF] hover:scale-110 transition duration-300 shadow-xl"
            style="text-shadow: 1px 1px 6px rgba(0, 0, 0, 0.8)"
          >
            ▶ Watch Live
          </button>
        </a>
      </div>
      <div class="mt-6">
        <div
          class="w-full h-[2px] bg-gradient-to-r from-transparent via-white to-transparent"
        ></div>
      </div>

      <!-- ZEE NEWS LIVE SECTION -->

      <div class="flex justify-center px-3 mt-10">
        <div
          class="w-full max-w-2xl bg-gradient-to-r from-red-900/60 via-black/80 to-red-900/60 border border-white/10 rounded-3xl shadow-2xl backdrop-blur-lg p-6 md:p-8 text-center space-y-5"
        >
          <!-- ZEE NEWS LOGO -->

          <div class="flex justify-center">
            <img
              src="https://upload.wikimedia.org/wikipedia/commons/thumb/a/a3/Zee_News_2025.svg/250px-Zee_News_2025.svg.png"
              class="h-12 md:h-14 object-contain"
              alt="Zee News Logo"
            />
          </div>

          <!-- HEADING -->

          <h2 class="text-2xl md:text-3xl font-bold text-red-400">
            📰 Watch Zee News Live 24×7
          </h2>

          <!-- DESCRIPTION -->

          <p
            class="text-gray-300 text-sm md:text-base leading-relaxed max-w-xl mx-auto"
          >
            Stay updated with the latest
            <span class="text-white font-semibold">India and World News</span>.
            Watch the official
            <span class="text-red-400 font-semibold"
              >Zee News Live Channel</span
            >
            anytime to get breaking news, political updates, sports news and
            important national events happening across the globe.
          </p>

          <!-- LIVE TEXT -->

          <p
            class="text-yellow-400 font-semibold animate-pulse text-sm md:text-base"
          >
            🔴 24 Hours Live News Coverage
          </p>

          <!-- BUTTON -->

          <a href="/watch-live-zeenews">
            <button
              class="px-8 py-3 my-3 rounded-full font-bold bg-gradient-to-r from-red-600 via-red-500 to-red-700 hover:scale-110 transition duration-300 shadow-xl"
            >
              ▶ Watch Zee News Live
            </button>
          </a>
        </div>
      </div>
    </div>

    <!-- FOOTER -->

    <footer
      class="bg-black/50 border-t border-white/20 text-center py-5 text-sm"
    >
      © 2026
      <span class="font-bold text-red-500">
        Cric<span class="text-white">Pulse</span>
      </span>
      • Developed by Naveen Rathore
    </footer>

    <script>
      const slides = [
        {
          img: "https://img10.hotstar.com/image/upload/f_auto,q_90,w_1920/sources/r1/cms/prod/8736/1772978088736-i",
          title: "TATA IPL 2026 ",
          desc: "Get Ready for the Biggest Cricket League – IPL | 28 March",
          logo: "https://res-1.cloudinary.com/people-first-jobs/image/upload/c_scale,dpr_auto,h_180/w2q0i78khhqe2oyw35oax5rkzxz9",
        },

        {
          img: "https://img10.hotstar.com/image/upload/f_auto,q_90,w_1920/sources/r1/cms/prod/2526/1772995532526-i",
          title: "India Winning Moment",
          desc: "Team India Lifts Their Third T20 World Cup Trophy!",
        },

        {
          img: "https://img10.hotstar.com/image/upload/f_auto,q_90,w_1920/sources/r1/cms/prod/8568/1767462408568-i",
          title: "Gujarat is Ready for 2nd Title",
          desc: "aava de!",
        },
        {
          img: "https://img10.hotstar.com/image/upload/f_auto,q_90,w_1920/sources/r1/cms/prod/2189/1773760442189-i",
          title: "How many records will Suryavanshi break?",
          desc: "Ready for smash this season!",
        },

        {
          img: "https://img10.hotstar.com/image/upload/f_auto,q_90,w_1920/sources/r1/cms/prod/6197/1773677026197-i",
          title: "What's Pant plan for new season!",
          desc: "Lucknow Super Giants",
        },
        {
          img: "https://img10.hotstar.com/image/upload/f_auto,q_90,w_1920/sources/r1/cms/prod/5572/1771239205572-i",
          title: "RR Captain",
          desc: "Ready on his new role",
        },
        {
          img: "https://img10.hotstar.com/image/upload/f_auto,q_90,w_1920/sources/r1/cms/prod/972/1767460910972-i",
          title: "RCB Ready for Second Title",
          desc: "Can the king’s soldiers lift another IPL trophy this season?",
        },
        {
          img: "https://img10.hotstar.com/image/upload/f_auto,q_90,w_1920/sources/r1/cms/prod/3980/1767461013980-i",
          title: "CSK Eye for 6th Title",
          desc: "CSK's new era will be able to win its 6th trophy",
        },
        {
          img: "https://img10.hotstar.com/image/upload/f_auto,q_90,w_1920/sources/r1/cms/prod/9454/1767460079454-i",
          title: "Mumbai Paltan Ready! to Smash!",
          desc: "Pandya's Paltan!",
        },
      ];

      let index = 0;

      const slider = document.getElementById("slider");
      const title = document.getElementById("slideTitle");
      const desc = document.getElementById("slideDesc");

      const dots = document.getElementById("dots");

      slides.forEach((_, i) => {
        const dot = document.createElement("div");

        dot.className =
          "w-3 h-3 bg-white/40 rounded-full cursor-pointer hover:bg-white";

        dot.onclick = () => {
          index = i;
          showSlide();
        };

        dots.appendChild(dot);
      });

      function showSlide() {
        slider.src = slides[index].img;
        title.innerText = slides[index].title;
        desc.innerText = slides[index].desc;

        document.querySelectorAll("#dots div").forEach((dot, i) => {
          dot.classList.remove("bg-white");
          if (i === index) dot.classList.add("bg-white");
        });
      }
      function nextSlide() {
        index = (index + 1) % slides.length;
        showSlide();
      }

      setInterval(nextSlide, 4000);

      showSlide();

      function toggleMenu() {
        let menu = document.getElementById("mobileMenu");

        if (menu.style.right === "0px") {
          menu.style.right = "-260px";
        } else {
          menu.style.right = "0px";
        }
      }

      // MATCH COUNTDOWN

      const matchDate = new Date("March 28, 2026 19:30:00").getTime();

      const countdown = setInterval(function () {
        const now = new Date().getTime();

        const distance = matchDate - now;

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor(
          (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
        );
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        document.getElementById("countdown1").innerHTML =
          days + "d " + hours + "h " + minutes + "m " + seconds + "s";

        if (distance < 0) {
          clearInterval(countdown);

          document.getElementById("countdown1").innerHTML = "MATCH LIVE 🔴";
        }
      }, 1000);
    </script>
    <script src="/socket.io/socket.io.js"></script>

    <script>
      const socket = io();

      socket.on("updateUsers", (count) => {
        document.getElementById("liveUsers").innerText = count;
      });
    </script>
  </body>
</html>
