<!DOCTYPE html>
<html>
  <head>
    <title>CricPulse-live</title>
    <link
      rel="icon"
      href="https://thumbs.dreamstime.com/b/cricket-sport-comet-fire-tail-flying-throw-logo-isolated-symbol-icon-badge-89929962.jpg"
      type="image/x-icon"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="google-site-verification"
      content="RQDDLZXyk8LLoNq02uDwhfcGWUhNYj4kGHlJc9W5ib0"
    />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body
    class="bg-gradient-to-r from-blue-900 via-black to-red-900 min-h-screen flex flex-col justify-between"
  >
    <!-- NAVBAR -->
    <nav class="bg-black/40 backdrop-blur-md border-b border-white/10">
      <div
        class="max-w-7xl mx-auto px-4 md:px-6 py-4 flex flex-col md:flex-row justify-between items-center gap-4 text-white"
      >
        <h1 class="text-2xl font-bold text-red-500">
          Cric<span class="text-white">Pulse</span>
        </h1>

        <div class="flex gap-4 flex-wrap justify-center mt-6">
          <!-- Home Button -->
          <a
            href="/"
            class="px-6 py-3 text-base font-semibold rounded-lg bg-blue-700 text-white shadow-lg hover:bg-blue-800 hover:shadow-xl transition-all duration-300"
          >
            Home
          </a>

          <!-- Help Button -->
          <a
            href="/help"
            class="px-6 py-3 text-base font-semibold rounded-lg bg-gradient-to-r from-purple-700 via-pink-600 to-red-600 text-white shadow-lg hover:from-purple-800 hover:via-pink-700 hover:to-red-700 hover:shadow-xl transition-all duration-300"
          >
            Help
          </a>

          <!-- Legal / Info Button -->
          <a
            href="/legal"
            class="px-6 py-3 text-base font-semibold rounded-lg bg-gradient-to-r from-gray-800 via-gray-700 to-gray-600 text-white shadow-lg hover:from-gray-900 hover:via-gray-800 hover:to-gray-700 hover:shadow-xl transition-all duration-300"
          >
            Read Full Disclaimer ⚖️
          </a>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <div
      class="flex flex-col items-center flex-grow text-white px-4 md:px-6 py-8 md:py-10 space-y-6 md:space-y-8"
    >
      <!-- SLIDER -->
      <div
        class="relative w-full max-w-5xl h-52 sm:h-64 md:h-[450px] overflow-hidden rounded-2xl md:rounded-3xl shadow-2xl border border-white/20"
      >
        <img
          id="slider"
          src="https://shifu.hotstarext.com/SOURCE/VOD/cd-2026-03-05/FinalINDvNZDTD_BillboardWEB-5f6ce618-3773-4d08-a385-d3a69e74f3a8.jpg"
          class="w-full h-full object-cover transition-all duration-700"
        />

        <div class="absolute inset-0 bg-black/40"></div>

        <!-- Logo -->
        <!-- <div
          class="absolute top-3 left-3 bg-white/10 backdrop-blur-md px-2 py-1 md:px-3 md:py-2 rounded-xl"
        >
          <img
            src="https://cdn.smartads.in/images/product/television/Star-Sports-1-Hindi-HD.png"
            alt="Star Sports Logo"
            class="w-14 md:w-24 rounded-full"
          />
        </div> -->

        <!-- Arrows -->
        <button
          onclick="prevSlide()"
          class="absolute left-2 md:left-4 top-1/2 -translate-y-1/2 bg-white/20 hover:bg-white/40 text-white text-2xl md:text-3xl px-3 py-1 md:px-4 md:py-2 rounded-full backdrop-blur-md"
        >
          ❮
        </button>

        <button
          onclick="nextSlide()"
          class="absolute right-2 md:right-4 top-1/2 -translate-y-1/2 bg-white/20 hover:bg-white/40 text-white text-2xl md:text-3xl px-3 py-1 md:px-4 md:py-2 rounded-full backdrop-blur-md"
        >
          ❯
        </button>
      </div>

      <!-- Heading -->
      <h1
        class="text-2xl sm:text-3xl md:text-6xl font-extrabold text-center leading-tight"
      >
        <span class="text-yellow-400">IPL 2026</span>
        <span class="text-white">&</span>
        <span class="text-blue-400">T20 World Cup</span>
      </h1>

      <h2
        class="text-lg sm:text-2xl md:text-3xl font-bold text-red-500 uppercase tracking-wide animate-pulse"
      >
        LIVE STREAMING 🔴
      </h2>

      <!-- Live Users Counter -->
      <div
        class="bg-black/60 backdrop-blur-md px-6 py-3 rounded-xl shadow-lg border border-red-500/40"
      >
        <h3 class="text-lg md:text-xl font-bold text-red-400 text-center">
          🔴 Live Users Watching:
          <span id="liveUsers" class="text-yellow-400">0</span>
        </h3>
      </div>

      <!-- Match Info Card -->
      <!-- Match Info Container -->
      <div
        class="flex flex-col md:flex-row justify-center items-stretch gap-6 mt-6 px-4 md:px-0"
      >
        <!-- Match 1 -->
        <div
          class="flex-1 bg-gray-900 text-white p-6 rounded-2xl shadow-lg text-center space-y-4 flex flex-col"
        >
          <h1 class="text-2xl font-bold text-yellow-400">Final-2026</h1>
          <div class="flex justify-center items-center gap-4 text-xl font-bold">
            <div class="flex items-center gap-2">
              <img
                src="https://flagcdn.com/nz.svg"
                alt="South Africa Flag"
                class="w-8 h-6 rounded-sm"
              />
              <span class="white">NZ</span>
            </div>
            <span class="text-white text-2xl font-extrabold">vs</span>
            <div class="flex items-center gap-2">
              <img
                src="https://flagcdn.com/in.svg"
                alt="Indian Flag"
                class="w-8 h-6 rounded-sm"
              />
              <span class="text-white">IND</span>
            </div>
          </div>
          <div class="text-sm sm:text-base md:text-lg text-gray-300 mt-auto">
            📅 Date:
            <span class="text-yellow-400 font-semibold">8 March 2026</span
            ><br />
            🏟 Venue:
            <span class="text-yellow-400 font-semibold"
              >Narendra Modi Stadium,Ahmedabad</span
            >
          </div>
          <div id="countdown1" class="text-3xl font-mono mt-2"></div>
        </div>
      </div>

      <a href="/squads" class="mt-4 w-full flex justify-center">
        <button
          class="px-4 sm:px-6 md:px-8 py-2 rounded-full bg-gradient-to-r from-purple-600 via-pink-500 to-red-500 text-white font-bold text-lg shadow-lg hover:scale-105 hover:shadow-purple-400/50 transition-all duration-300 break-words text-center"
        >
          👥 View Squad
        </button>
      </a>

      <!-- Watch Live Button -->
      <a href="/watch-live">
        <button
          class="mt-4 px-6 sm:px-8 md:px-10 py-3 md:py-4 text-base md:text-lg font-bold rounded-full bg-gradient-to-r from-red-500 via-orange-500 to-yellow-400 shadow-2xl hover:scale-110 hover:shadow-red-500/50 transition-all duration-300 ease-in-out"
        >
          ▶ Watch Live Now
        </button>
      </a>
    </div>

    <!-- Footer -->
    <footer
      class="bg-black/50 backdrop-blur-md text-center text-gray-300 py-4 md:py-5 border-t border-white/20 text-sm md:text-base flex flex-col md:flex-row justify-center items-center gap-2"
    >
      <span>© 2026 Live Cricket Stream</span>
      <span class="hidden md:inline">|</span>
      <span>
        Developed by
        <a
          href="/"
          class="text-yellow-400 font-semibold hover:text-yellow-300 transition-colors duration-300"
        >
          Naveen Rathore
        </a>
      </span>
    </footer>

    <!-- Scripts -->
    <script>
      // Slider
      const images = [
        "https://shifu.hotstarext.com/SOURCE/VOD/cd-2026-03-05/FinalINDvNZDTD_BillboardWEB-5f6ce618-3773-4d08-a385-d3a69e74f3a8.jpg",
        "https://img1.hotstarext.com/image/upload/f_auto/sources/r1/cms/prod/2163/1770273252163-h",
        "https://khelnow.com/_next/image?url=https%3A%2F%2Fassets.khelnow.com%2Fnews%2Fuploads%2F2026%2F02%2FT20-wc-Trophy-Lead.jpg&w=1920&q=75",
        "https://img10.hotstar.com/image/upload/f_auto,q_90,w_1920/sources/r1/cms/prod/1554/1772279231554-i",
      ];

      let index = 0;
      const slider = document.getElementById("slider");

      function showSlide(i) {
        slider.src = images[i];
      }

      function nextSlide() {
        index = (index + 1) % images.length;
        showSlide(index);
      }

      function prevSlide() {
        index = (index - 1 + images.length) % images.length;
        showSlide(index);
      }

      setInterval(nextSlide, 4000);

      // Match 1 Countdown
      const matchDate1 = new Date("2026-03-08 19:00:00").getTime();
      const countdownEl1 = document.getElementById("countdown1");

      function updateCountdown1() {
        const now = new Date().getTime();
        const distance = matchDate1 - now;

        if (distance < 0) {
          countdownEl1.innerHTML = "Match Streaming Live 🔴";
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor(
          (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
        );
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        countdownEl1.innerHTML = `${days}d ${hours}h ${minutes}m ${seconds}s`;
      }

      // Match 2 Countdown
      const matchDate2 = new Date("2026-03-05 19:00:00").getTime();
      const countdownEl2 = document.getElementById("countdown2");

      function updateCountdown2() {
        const now = new Date().getTime();
        const distance = matchDate2 - now;

        if (distance < 0) {
          countdownEl2.innerHTML = "Match Streaming Live 🔴";
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor(
          (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
        );
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        countdownEl2.innerHTML = `${days}d ${hours}h ${minutes}m ${seconds}s`;
      }

      // Start countdowns
      setInterval(updateCountdown1, 1000);
      setInterval(updateCountdown2, 1000);
      updateCountdown1();
      updateCountdown2();
    </script>
    <!-- Socket.io -->
    <script src="/socket.io/socket.io.js"></script>

    <script>
      const socket = io();

      socket.on("updateUsers", function (count) {
        document.getElementById("liveUsers").innerText = count;
      });
    </script>
  </body>
</html>
