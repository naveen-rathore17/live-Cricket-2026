<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>CricPulse Live - Matches</title>

    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
      body {
        background: linear-gradient(-45deg, #000000, #020617, #0f172a, #000000);
        background-size: 400% 400%;
        animation: gradientMove 10s ease infinite;
      }

      @keyframes gradientMove {
        0% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
        100% {
          background-position: 0% 50%;
        }
      }
    </style>
  </head>

  <body class="min-h-screen text-white flex flex-col">
    <!-- NAVBAR -->
    <nav
      class="flex justify-between items-center px-4 sm:px-6 md:px-8 py-4 bg-black/40 backdrop-blur-xl border-b border-white/10 sticky top-0 z-50"
    >
      <a href="/" class="text-2xl md:text-3xl font-bold text-red-500">
        Cric<span class="text-white">Pulse</span>
      </a>

      <div class="space-x-4 font-semibold">
        <a href="/" class="hover:text-red-400 transition">Home</a>
        <a href="/squads" class="hover:text-red-400 transition">Squad</a>
      </div>
    </nav>

    <!-- MAIN -->
    <div class="flex-grow flex items-center justify-center px-4 relative">
      <!-- Glow BG -->
      <div
        class="absolute w-96 h-96 bg-blue-600 opacity-20 blur-3xl rounded-full top-10 left-10"
      ></div>
      <div
        class="absolute w-96 h-96 bg-purple-600 opacity-20 blur-3xl rounded-full bottom-10 right-10"
      ></div>

      <div
        class="max-w-6xl w-full bg-white/5 border border-white/10 rounded-3xl p-6 md:p-10 backdrop-blur-xl shadow-2xl"
      >
        <!-- HEADING -->
        <h1 class="flex flex-col items-center justify-center text-center mb-6">
          <!-- TEXT -->
          <span
            class="text-3xl md:text-5xl font-extrabold text-yellow-400 tracking-wide"
          >
            🏏 IPL 2026
          </span>
        </h1>

        <!-- LIVE -->
        <div class="flex justify-center mb-4">
          <span
            class="bg-red-600 px-5 py-1 rounded-full text-sm font-bold animate-pulse"
          >
            LIVE
          </span>
        </div>

        <h2
          class="text-3xl md:text-5xl font-extrabold text-center mb-10 bg-gradient-to-r from-blue-400 to-purple-500 bg-clip-text text-transparent"
        >
          LIVE CRICKET EXPERIENCE
        </h2>

        <!-- MATCH CARDS -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- MATCH 1 -->
          <div class="relative group">
            <div
              class="absolute inset-0 rounded-3xl bg-gradient-to-r from-blue-500 to-purple-600 opacity-20 blur-xl group-hover:opacity-40 transition"
            ></div>

            <div
              class="relative bg-black/80 backdrop-blur-xl rounded-3xl p-6 border border-white/10 shadow-[0_0_30px_rgba(0,0,0,0.9)] group-hover:shadow-[0_0_40px_rgba(59,130,246,0.6)] transition-all duration-500 hover:-translate-y-1 hover:scale-[1.02]"
            >
              <div class="flex justify-between mb-4">
                <span
                  class="text-xs bg-blue-500/20 px-3 py-1 rounded-full text-blue-400"
                >
                  Match 1
                </span>
                <span class="text-xs text-gray-500">IPL T20</span>
              </div>

              <div class="flex justify-between items-center mb-6">
                <div class="flex flex-col items-center gap-2">
                  <img
                    src="https://upload.wikimedia.org/wikipedia/en/thumb/d/d4/Royal_Challengers_Bengaluru_Logo.svg/250px-Royal_Challengers_Bengaluru_Logo.svg.png"
                    class="w-12 h-14"
                  />
                  <p class="text-sm text-gray-200">RCB</p>
                </div>

                <div class="text-center">
                  <p class="text-xl text-yellow-400 font-bold">VS</p>
                  <p class="text-xs text-gray-500">T20</p>
                </div>

                <div class="flex flex-col items-center gap-2">
                  <img
                    src="https://upload.wikimedia.org/wikipedia/en/thumb/5/51/Sunrisers_Hyderabad_Logo.svg/250px-Sunrisers_Hyderabad_Logo.svg.png"
                    class="w-14 h-14"
                  />
                  <p class="text-sm text-gray-200">SRH</p>
                </div>
              </div>

              <div class="text-center mb-4">
                <p class="text-gray-500 text-sm">
                  📍 M.Chinnaswamy Stadium, Bengaluru
                </p>
                <p class="text-yellow-400">28 March • 7:30 PM</p>
              </div>

              <div class="text-center mb-4">
                <p id="countdown1" class="text-green-400 font-bold">
                  Loading...
                </p>
              </div>

              <div
                class="text-center text-xs text-gray-600 border-t border-white/10 pt-3"
              >
                🎥 Live streaming will begin once the match starts
              </div>
            </div>
          </div>

          <!-- MATCH 2 -->
          <div class="relative group">
            <div
              class="absolute inset-0 rounded-3xl bg-gradient-to-r from-purple-500 to-blue-500 opacity-20 blur-xl group-hover:opacity-40 transition"
            ></div>

            <div
              class="relative bg-black/80 backdrop-blur-xl rounded-3xl p-6 border border-white/10 shadow-[0_0_30px_rgba(0,0,0,0.9)] group-hover:shadow-[0_0_40px_rgba(168,85,247,0.6)] transition-all duration-500 hover:-translate-y-1 hover:scale-[1.02]"
            >
              <div class="flex justify-between mb-4">
                <span
                  class="text-xs bg-purple-500/20 px-3 py-1 rounded-full text-purple-400"
                >
                  Match 2
                </span>
                <span class="text-xs text-gray-500">IPL T20</span>
              </div>

              <div class="flex justify-between items-center mb-6">
                <div class="flex flex-col items-center gap-2">
                  <img
                    src="https://upload.wikimedia.org/wikipedia/en/thumb/c/cd/Mumbai_Indians_Logo.svg/250px-Mumbai_Indians_Logo.svg.png"
                    class="w-14 h-14"
                  />
                  <p class="text-sm text-gray-200">MI</p>
                </div>

                <div class="text-center">
                  <p class="text-xl text-yellow-400 font-bold">VS</p>
                  <p class="text-xs text-gray-500">T20</p>
                </div>

                <div class="flex flex-col items-center gap-2">
                  <img
                    src="https://upload.wikimedia.org/wikipedia/en/thumb/4/4c/Kolkata_Knight_Riders_Logo.svg/250px-Kolkata_Knight_Riders_Logo.svg.png"
                    class="w-12 h-14"
                  />
                  <p class="text-sm text-gray-200">KKR</p>
                </div>
              </div>

              <div class="text-center mb-4">
                <p class="text-gray-500 text-sm">📍 Wankhede Stadium, Mumbai</p>
                <p class="text-yellow-400">29 March • 7:30 PM</p>
              </div>

              <div class="text-center mb-4">
                <p id="countdown2" class="text-green-400 font-bold">
                  Loading...
                </p>
              </div>

              <div
                class="text-center text-xs text-gray-600 border-t border-white/10 pt-3"
              >
                🎥 Live streaming will begin once the match starts
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FOOTER -->
    <footer
      class="bg-black/50 border-t border-white/20 text-center py-4 text-xs"
    >
      © 2026
      <span class="font-bold text-red-500"
        >Cric<span class="text-white">Pulse</span></span
      >
      • Developed by Naveen Rathore
    </footer>

    <!-- COUNTDOWN -->
    <script>
      function startCountdown(id, date) {
        const el = document.getElementById(id);

        setInterval(() => {
          const now = new Date().getTime();
          const distance = new Date(date).getTime() - now;

          if (distance < 0) {
            el.innerHTML = `
            <a href="/watch-live"
              class="inline-block mt-2 px-6 py-2 rounded-full
              bg-gradient-to-r from-blue-500 to-purple-600
              text-white font-semibold text-sm
              hover:scale-110 transition">
              ▶ Watch Live
            </a>
          `;
            return;
          }

          const d = Math.floor(distance / (1000 * 60 * 60 * 24));
          const h = Math.floor((distance / (1000 * 60 * 60)) % 24);
          const m = Math.floor((distance / (1000 * 60)) % 60);
          const s = Math.floor((distance / 1000) % 60);

          el.innerHTML = `${d}d ${h}h ${m}m ${s}s`;
        }, 1000);
      }

      startCountdown("countdown1", "March 28, 2026 19:30:00");
      startCountdown("countdown2", "March 29, 2026 19:30:00");
    </script>
  </body>
</html>
