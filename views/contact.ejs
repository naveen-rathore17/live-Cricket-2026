<!DOCTYPE html>
<html>
  <head>
    <title>Contact - CricPulse</title>

    <!-- <link rel="icon"
href="https://thumbs.dreamstime.com/b/cricket-sport-comet-fire-tail-flying-throw-logo-isolated-symbol-icon-badge-89929962.jpg"/> -->
    <link rel="icon" type="image/png" href="/images/favicon.png" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body
    class="bg-gradient-to-r from-blue-900 via-black to-red-900 min-h-screen flex flex-col"
  >
    <!-- Navbar -->

    <nav class="bg-black/40 backdrop-blur-md border-b border-white/10">
      <div
        class="max-w-7xl mx-auto px-4 md:px-6 py-4 flex justify-between items-center text-white"
      >
        <a href="/" class="text-2xl md:text-3xl font-bold text-red-500">
          Cric<span class="text-white">Pulse</span>
        </a>

        <div class="space-x-4 font-bold text-m md:text-base">
          <a href="/" class="hover:text-red-400">Home</a>
          <a href="/live-matches" class="hover:text-red-400">Watch</a>
        </div>
      </div>
    </nav>

    <!-- Contact Form -->

    <div class="flex-grow flex items-center justify-center px-6 py-12">
      <div
        class="bg-white/10 backdrop-blur-lg p-8 rounded-2xl shadow-xl border border-white/20 w-full max-w-lg text-white"
      >
        <h2 class="text-3xl font-bold text-center mb-6 text-yellow-400">
          📩 Contact Support
        </h2>

        <p class="text-center text-gray-300 mb-6">
          If you face any streaming issue, please tell us your problem.
        </p>

        <form action="/contact" method="POST" class="space-y-4">
          <input
            type="text"
            name="name"
            placeholder="Your Name"
            required
            class="w-full p-3 rounded-lg bg-black/40 border border-white/20 outline-none"
          />

          <input
            type="email"
            name="email"
            placeholder="Your Email"
            required
            class="w-full p-3 rounded-lg bg-black/40 border border-white/20 outline-none"
          />

          <textarea
            name="problem"
            rows="4"
            placeholder="Describe your streaming problem..."
            required
            class="w-full p-3 rounded-lg bg-black/40 border border-white/20 outline-none"
          ></textarea>

          <button
            class="w-full bg-red-500 hover:bg-red-600 py-3 rounded-lg font-bold transition"
          >
            Submit
          </button>
        </form>
      </div>
    </div>

    <footer
      class="bg-black/50 border-t border-white/20 text-center py-5 text-white"
    >
      © 2026 CricPulse • Developed by Naveen Rathore
    </footer>
  </body>
</html>
