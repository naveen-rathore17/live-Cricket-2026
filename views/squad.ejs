<style>

/* Animated Stadium Background */

.bg-stadium{
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
background:url("https://img10.hotstar.com/image/upload/f_auto,q_90,w_1920/sources/r1/cms/prod/8736/1772978088736-i") top center/cover no-repeat;
animation:zoomBg 25s infinite alternate ease-in-out;
z-index:-2;
}

.bg-overlay{
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
background:rgba(0,0,0,0.75);
z-index:-1;
}

@keyframes zoomBg{
0%{transform:scale(1);}
100%{transform:scale(1.1);}
}

</style>

</head>

