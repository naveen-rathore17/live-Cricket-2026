<!DOCTYPE html>
<html>
<head>
  <title>CricPulse | Final Teams Squad</title>
   <link
      rel="icon"
      href="https://thumbs.dreamstime.com/b/cricket-sport-comet-fire-tail-flying-throw-logo-isolated-symbol-icon-badge-89929962.jpg"
      type="image/x-icon"
    />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-gradient-to-br from-black via-gray-900 to-black text-white min-h-screen">

<!-- NAVBAR -->

<nav class="bg-black/70 backdrop-blur-lg border-b border-white/10 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto flex justify-between items-center px-6 py-4">

    <h1 class="text-2xl md:text-3xl font-bold text-red-500">
      Cric<span class="text-white">Pulse</span>
    </h1>

    <div class="flex gap-4 md:gap-6 font-semibold text-sm md:text-base">
      <a href="/" class="hover:text-red-400 transition">Home</a>
      <a href="/watch-live" class="hover:text-red-400 transition">Watch</a>
      <a href="/help" class="hover:text-red-400 transition">Help</a>
    </div>

  </div>
</nav>

<!-- PAGE HEADER -->

<div class="text-center mt-10 mb-10 px-4">

<h1 class="text-5xl md:text-6xl font-extrabold text-center mb-8 bg-gradient-to-r from-blue-400 via-yellow-400 to-red-500 bg-clip-text text-transparent">
  ICC T20 World Cup 2026
</h1>

<h2 class="text-center text-gray-300 text-lg mb-10">
  Final Teams Squad
</h2>

</div>

<% 
let top4 = [
{name:"India", flag:"https://flagcdn.com/in.svg"},
{name:"New Zealand", flag:"https://flagcdn.com/nz.svg"},
];

let squads = {

India: [
"Suryakumar Yadav (c)",
"Abhishek Sharma",
"Tilak Varma",
"Sanju Samson (wk)",
"Shivam Dube",
"Ishan Kishan",
"Hardik Pandya",
"Arshdeep Singh",
"Jasprit Bumrah",
"Varun Chakaravarthy",
"Kuldeep Yadav",
"Axar Patel",
"Washington Sundar",
"Rinku Singh",
"Mohammed Siraj"
],

"New Zealand":[
"Mitchell Santner (C)",
"Finn Allen",
"Mark Chapman",
"Devon Conway",
"Jacob Duffy",
"Lockie Ferguson",
"Matt Henry",
"Daryl Mitchell",
"James Neesham",
"Glenn Phillips",
"Rachin Ravindra",
"Tim Seifert (wk)",
"Ish Sodhi",
"Kyle Jamieson"
]

};

let flags = {
India:"https://flagcdn.com/in.svg",
"New Zealand":"https://flagcdn.com/nz.svg"
};
%>


<!-- FINAL TEAMS -->

<div class="flex flex-wrap justify-center gap-6 mb-12">

<% for(let i=0;i<top4.length;i++){ %>

<div class="bg-white/5 backdrop-blur-md border border-white/10 p-6 rounded-2xl w-36 text-center hover:scale-105 transition duration-300 shadow-xl">

<img src="<%= top4[i].flag %>" class="w-16 mx-auto mb-3 rounded-sm">

<p class="font-bold text-lg"><%= top4[i].name %></p>

</div>

<% } %>

</div>


<!-- SQUADS -->

<div class="max-w-6xl mx-auto px-4 space-y-10">

<% for(let teamName in squads){ %>

<div class="bg-white/5 backdrop-blur-lg border border-white/10 rounded-3xl p-6 shadow-2xl">

<!-- TEAM HEADER -->

<div class="flex items-center gap-4 mb-6">

<img src="<%= flags[teamName] %>" class="w-12 rounded">

<h2 class="text-2xl md:text-3xl font-bold">
<%= teamName %> Squad
</h2>

</div>


<!-- PLAYERS GRID -->

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">

<% for(let j=0;j<squads[teamName].length;j++){ %>

<div class="bg-gray-800 hover:bg-yellow-400 hover:text-black text-center py-3 px-2 rounded-lg font-semibold transition duration-300 cursor-pointer shadow-md">

<%= squads[teamName][j] %>

</div>

<% } %>

</div>

</div>

<% } %>

</div>


<!-- ACTION BUTTON -->

<div class="text-center mt-12">

<a href="/">

<button class="bg-gradient-to-r from-red-500 via-orange-500 to-yellow-400 text-black font-bold px-8 py-4 rounded-full text-lg hover:scale-110 transition shadow-xl">

🏠 Back to Home

</button>

</a>

</div>


<!-- FOOTER -->

<footer class="text-center text-gray-400 mt-16 pb-6">

🏏 CricPulse • T20 World Cup 2026 Final Squads

</footer>


</body>
</html>