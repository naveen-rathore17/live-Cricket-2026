<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>CricPulse News Live 🔴</title>

    <!-- <link
      rel="icon"
      href="https://thumbs.dreamstime.com/b/cricket-sport-comet-fire-tail-flying-throw-logo-isolated-symbol-icon-badge-89929962.jpg"
      type="image/x-icon"
    /> -->
    <link rel="icon" type="image/png" href="/images/favicon2.png" />

    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body
    class="bg-gradient-to-br from-gray-950 via-black to-gray-900 min-h-screen text-white flex flex-col"
  >
    <!-- Navbar -->

    <nav
      class="flex flex-wrap justify-between items-center px-2 md:px-6 py-3 bg-black/70 backdrop-blur-md shadow-lg border-b border-red-500/30"
    >
      <a href="/" class="text-2xl md:text-3xl font-bold text-red-500">
          Cric<span class="text-white">Pulse</span>
        </a>

      <div class="mt-2 md:mt-0">
        <a
          href="/"
          class="hover:text-red-400 px-2 py-1 rounded-full text-sm font-semibold transition"
        >
          Home
        </a>
        <a
          href="/contact"
          class="hover:text-red-400 px-3 py-1 rounded-full text-sm font-semibold transition"
        >
          Contact
        </a>
      </div>
    </nav>

    <!-- Main -->

    <div class="flex-grow">
      <!-- News Header -->

      <div class="text-center mt-10 md:mt-12 px-4 space-y-4 md:space-y-5">
        <div class="flex justify-center">
          <img
            src="https://upload.wikimedia.org/wikipedia/commons/thumb/a/a3/Zee_News_2025.svg/250px-Zee_News_2025.svg.png"
            class="h-12 md:h-16 drop-shadow-lg"
            alt="Zee News"
          />
        </div>

        <div class="flex justify-center">
          <span
            class="bg-red-600 text-white px-4 py-1 text-xs md:text-sm font-bold rounded-full animate-pulse shadow-lg"
          >
            🔴 LIVE NEWS
          </span>
        </div>

        <h1
          class="text-2xl md:text-5xl font-extrabold text-white tracking-wide leading-snug"
        >
          Watch Zee News Live 24×7
        </h1>

        <p class="text-gray-400 text-xs md:text-base max-w-xl mx-auto">
          Breaking News • Politics • India Updates • World Headlines • Live
          Coverage
        </p>
      </div>

      <!-- Breaking News Ticker -->

      <div
        class="mt-8 md:mt-10 bg-gradient-to-r from-red-700 via-red-600 to-red-700 py-2 md:py-3 overflow-hidden shadow-lg"
      >
        <div
          class="whitespace-nowrap animate-[scroll_18s_linear_infinite] text-sm md:text-2xl font-extrabold tracking-wider"
        >
          🔴 BREAKING NEWS : India Latest Updates | World Headlines | Politics |
          Economy | Sports | Stay Updated With Zee News Live Coverage
        </div>
      </div>

      <!-- Video Section -->

      <div class="flex justify-center mt-8 md:mt-10 px-3 md:px-4">
        <div
          class="bg-gradient-to-br from-gray-900 via-black to-gray-900 p-3 md:p-6 rounded-2xl shadow-2xl border border-white/10 w-full max-w-4xl"
        >
          <!-- Top Bar -->

          <div class="flex flex-wrap gap-2 items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span
                class="bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full animate-pulse"
              >
                LIVE
              </span>

              <span class="text-gray-300 text-xs sm:text-sm">
                Streaming Now
              </span>
            </div>

            <div class="flex items-center gap-2">
              <!-- Live Users -->

              <div
                class="flex items-center gap-1 bg-red-600 text-white px-2 py-1 rounded-full text-xs font-bold"
              >
                <span class="relative flex h-2 w-2">
                  <span
                    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"
                  ></span>

                  <span
                    class="relative inline-flex rounded-full h-2 w-2 bg-white"
                  ></span>
                </span>

                <span id="liveUsers">0</span> Live
              </div>

              <!-- Help Button -->

              <button
                onclick="openHelp()"
                class="bg-blue-600 hover:bg-blue-700 px-2 py-1 rounded-md text-xs font-semibold transition"
              >
                Help
              </button>
            </div>
          </div>

          <!-- Video -->

          <div id="video-container" class="aspect-video w-full">
            <iframe
              id="vidgyor_iframe"
              src="<%=streamNews%>"
              frameborder="0"
              width="100%"
              style="border: none"
              allowfullscreen
              allow="autoplay; fullscreen"
              scrolling="no"
              height="100%"
              class="rounded-xl"
            >
            </iframe>
          </div>
        </div>
      </div>
    </div>

    <!-- Help Modal -->

    <div
      id="helpModal"
      class="hidden fixed inset-0 bg-black/80 flex items-center justify-center z-50 px-4"
    >
      <div class="bg-gray-900 p-5 rounded-xl max-w-md w-full shadow-2xl">
        <h2 class="text-xl font-bold mb-4">Streaming Help</h2>

        <ul class="space-y-2 text-gray-300 text-sm">
          <li>📶 Check your internet connection.</li>
          <li>🔄 Refresh page if video not loading.</li>
          <li>🎧 Use headphones for better sound.</li>
          <li>📱 Rotate phone for full screen.</li>
        </ul>

        <button
          onclick="closeHelp()"
          class="mt-6 w-full bg-red-600 hover:bg-red-700 py-2 rounded-lg transition"
        >
          Close
        </button>
      </div>
    </div>

    <!-- Footer -->

    <footer
      class="bg-black/50 border-t border-white/20 text-center py-4 text-xs mt-10 px-3"
    >
      © 2026

      <span class="font-bold text-red-500">
        Cric<span class="text-white">Pulse</span>
      </span>

      • Developed by Naveen Rathore
    </footer>

    <script>
      function openHelp() {
        document.getElementById("helpModal").classList.remove("hidden");
      }

      function closeHelp() {
        document.getElementById("helpModal").classList.add("hidden");
      }
    </script>

    <script src="/socket.io/socket.io.js"></script>

    <script>
      const socket = io();

      socket.on("updateUsers", function (count) {
        document.getElementById("liveUsers").innerText = count;
      });
    </script>

    <style>
      @keyframes scroll {
        0% {
          transform: translateX(100%);
        }
        100% {
          transform: translateX(-100%);
        }
      }
    </style>
  </body>
</html>
